# ── server ─────────────────────────────────────────────
ANBAR_HOST=0.0.0.0
ANBAR_PORT=8000
# public base URL used to build returned download links (set your domain here)
ANBAR_BASE_URL=http://127.0.0.1:8317

# ── storage backend (F2: bot) ──────────────────────────
ANBAR_BACKEND=bot
# BotFather token — required for backend=bot
ANBAR_BOT_TOKEN=123456:REPLACE_ME
# storage channel: private channel the bot administers (create it manually,
# add the bot as admin with full rights) — required for backend=bot
ANBAR_CHANNEL_ID=@yourprivatechannel

# ── MTProto (F5, optional) ─────────────────────────────
# get api_id/api_hash from https://my.telegram.org; use a dedicated account.
# login once:  docker compose run --rm anbar anbarctl login \
#                 --api-id ... --api-hash ... --phone +98...
ANBAR_API_ID=
ANBAR_API_HASH=
ANBAR_SESSION_FILE=/app/secrets/session.session
# ANBAR_LOGIN_PHONE=+98...   # optional default for `anbarctl login`

# ── limits ─────────────────────────────────────────────
# logical ceiling; the backend's real ceiling still applies per chunk
ANBAR_MAX_UPLOAD_MB=2000

# ── chunking (v1.1) ────────────────────────────────────
ANBAR_CHUNKING=auto
ANBAR_CHUNK_SIZE_MB=16

# ── flood pacing (v0.8.3, bot backend) ─────────────────
# min gap between two sendDocument calls (shortens Telegram flood windows)
ANBAR_FLOOD_SEND_GAP_S=1.1
# max cumulative seconds an upload may spend waiting out 429s before it
# fails with 504 (and rolls the posted chunks back)
ANBAR_FLOOD_BUDGET_S=2400

# ── auth (default ON; toggle at runtime via API/CLI) ───
ANBAR_AUTH_ENABLED=true
# 32+ random bytes recommended:  openssl rand -hex 32
ANBAR_ADMIN_KEY=change-me-admin
ANBAR_API_KEY=change-me
ANBAR_HMAC_SECRET=change-me-hmac

# ── cache (optional, default off) ──────────────────────
ANBAR_CACHE_ENABLED=false
ANBAR_CACHE_DIR=/app/data/cache
ANBAR_CACHE_MAX_MB=512

# ── rate limits (F6; 0 disables that limiter) ──────────
# downloads per minute, per (client IP, object)
ANBAR_RATE_DOWNLOAD_PER_MIN=30
# uploads per minute, per API key
ANBAR_RATE_UPLOAD_PER_MIN=20

# ── web UI sessions (F7) ──────────────────────────────
# session cookie lifetime in seconds (default 12h; max 7d)
# ANBAR_WEB_SESSION_TTL=43200
# failed/total login attempts per minute, per IP (0 disables)
# ANBAR_RATE_LOGIN_PER_MIN=10
# logging: DEBUG|INFO|WARNING|ERROR (INFO shows flood waits & chunk progress)
ANBAR_LOG_LEVEL=INFO
