# ── server ─────────────────────────────────────────────
ANBAR_HOST=0.0.0.0
ANBAR_PORT=8000
# public base URL used to build returned download links (set your domain here)
ANBAR_BASE_URL=http://127.0.0.1:8317

# ── storage backend (F2: bot) ──────────────────────────
ANBAR_BACKEND=bot
# BotFather token — required for backend=bot
ANBAR_BOT_TOKEN=123456:REPLACE_ME
# storage channel: private channel the bot administers (create it manually,
# add the bot as admin with full rights) — required for backend=bot
ANBAR_CHANNEL_ID=@yourprivatechannel

# ── MTProto (F5, optional) ─────────────────────────────
ANBAR_API_ID=
ANBAR_API_HASH=
ANBAR_SESSION_FILE=/app/secrets/session.session

# ── limits ─────────────────────────────────────────────
# logical ceiling; the backend's real ceiling still applies per chunk
ANBAR_MAX_UPLOAD_MB=2000

# ── chunking (v1.1) ────────────────────────────────────
ANBAR_CHUNKING=auto
ANBAR_CHUNK_SIZE_MB=16

# ── auth (default ON; toggle at runtime via API/CLI) ───
AUTH_ENABLED=true
# 32+ random bytes recommended:  openssl rand -hex 32
ANBAR_ADMIN_KEY=change-me-admin
ANBAR_API_KEY=change-me
ANBAR_HMAC_SECRET=change-me-hmac

# ── cache (optional, default off) ──────────────────────
ANBAR_CACHE_ENABLED=false
ANBAR_CACHE_DIR=/app/data/cache
ANBAR_CACHE_MAX_MB=512