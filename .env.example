# ── server ─────────────────────────────────────────────
TGLINK_HOST=0.0.0.0
TGLINK_PORT=8000
# public base URL used to build returned download links (set your domain here)
TGLINK_BASE_URL=http://127.0.0.1:8317

# ── storage backend (F2: bot) ──────────────────────────
TGLINK_BACKEND=bot
# BotFather token — required for backend=bot
TGLINK_BOT_TOKEN=123456:REPLACE_ME
# storage channel id (bot must be admin) — created on first run if empty
TGLINK_CHANNEL_ID=

# ── MTProto (F5, optional) ─────────────────────────────
TGLINK_API_ID=
TGLINK_API_HASH=
TGLINK_SESSION_FILE=/app/secrets/session.session

# ── limits ─────────────────────────────────────────────
# logical ceiling; the backend's real ceiling still applies per chunk
TGLINK_MAX_UPLOAD_MB=2000

# ── chunking (v1.1) ────────────────────────────────────
TGLINK_CHUNKING=auto
TGLINK_CHUNK_SIZE_MB=16

# ── auth (default ON; toggle at runtime via API/CLI) ───
AUTH_ENABLED=true
# 32+ random bytes recommended:  openssl rand -hex 32
TGLINK_ADMIN_KEY=change-me-admin
TGLINK_API_KEY=change-me
TGLINK_HMAC_SECRET=change-me-hmac

# ── cache (optional, default off) ──────────────────────
CACHE_ENABLED=false
CACHE_DIR=/app/data/cache
CACHE_MAX_MB=512